rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public share docs: anyone WITH THE LINK (the exact id) can read one — but
    // `list`/query is denied so the collection can't be enumerated. (`read` alone
    // would grant both get AND list, exposing every share's transcript.)
    // A link is closed when the server revoked it (its recording went private
    // or was deleted) or when it is a live link whose take has ended
    // (live == false). A closed link reads as nothing and cannot be written
    // back into; only the owner can delete its tombstone.
    match /shares/{shareId} {
      // Links made before the 2026-11-08 deploy stay open after their live
      // take ended (canonical.js LIVE_GRANDFATHER_BEFORE).
      function before(d) {
        return (d.get('createdAt', null) is timestamp && d.createdAt < timestamp.date(2026, 11, 8))
            || (d.get('createdAt', null) is string && d.createdAt < "2026-11-08T00:00:00Z");
      }
      function open(d) { return d.get('revoked', false) != true && (d.get('live', true) != false || before(d)); }
      allow get: if resource == null || open(resource.data);
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.get('revoked', false) != true;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && resource.data.get('revoked', false) != true
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.get('revoked', false) != true;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Ask's daily budget across all shares; Cloud Functions only.
    match /askQuota/{day} {
      allow read, write: if false;
    }

    // API keys are managed only by Cloud Functions (admin); no client access.
    match /apiKeys/{id} {
      allow read, write: if false;
    }

    // Transcription job locks — written only by Cloud Functions (admin).
    match /transcriptions/{id} {
      allow read, write: if false;
    }

    // Migration phase: readable by any signed-in client (the phone shows
    // "migration in progress"), set only by the migrator with admin rights.
    // config/privacy (the always-private folder names) is server-only.
    match /config/{doc} {
      allow read: if request.auth != null && doc != "privacy";
      allow write: if false;
    }

    // Who the owner is (name, a line for AssemblyAI, the profile the review
    // reads). Written from the owner's notes with admin rights; the phone
    // only shows it.
    // Ids and display names of the owner's first-degree people, pushed from
    // the CRM on the Mac by tools/push-people.js; the name picker reads them.
    match /ownerPeople/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /ownerProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Canonical recording documents: the owner listens, every write goes
    // through a callable. Webhook payloads are server-only.
    match /recordings/{uid}/items/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /webhooks/{w} { allow read, write: if false; }
    }
  }
}
