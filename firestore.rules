rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public share docs: anyone WITH THE LINK (the exact id) can read one — but
    // `list`/query is denied so the collection can't be enumerated. (`read` alone
    // would grant both get AND list, exposing every share's transcript.)
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // API keys are managed only by Cloud Functions (admin); no client access.
    match /apiKeys/{id} {
      allow read, write: if false;
    }

    // Transcription job locks — written only by Cloud Functions (admin).
    match /transcriptions/{id} {
      allow read, write: if false;
    }

    // Migration phase: readable by any signed-in client (the phone shows
    // "migration in progress"), set only by the migrator with admin rights.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Who the owner is (name, a line for AssemblyAI, the profile the review
    // reads). Written from the owner's notes with admin rights; the phone
    // only shows it.
    match /ownerProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Canonical recording documents: the owner listens, every write goes
    // through a callable. Webhook payloads are server-only.
    match /recordings/{uid}/items/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /webhooks/{w} { allow read, write: if false; }
    }
  }
}
